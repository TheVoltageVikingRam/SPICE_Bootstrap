simulator lang=spectre

global 0 vdd vss
include "./22nm_HP.pm"

vdd_I1 ( vdd 0 ) vsource dc=0.8
vss_I1 ( vss 0 ) vsource dc=0
vin ( in0 0 ) vsource type=pulse val0=0 val1=0.8 delay=0 rise=1.0p fall=1.0p width=6n period=12n

*************INVERTER************
subckt inv ( in out vdd vss )
parameters L=22n Ln=L Wn=2*Ln k=1.3 mult=1
m1 ( out in vdd vdd ) pmos l=L w=k*Wn*mult
m2 ( out in vss vss ) nmos l=L w=Wn*mult

ends inv


X0 ( in0 nd0 vdd vss ) inv mult=1
X1 ( nd0 nd1 vdd vss ) inv mult=10.8105149033
X2 ( nd1 nd2 vdd vss ) inv mult=116.867232475
X3 ( nd2 out vdd vss ) inv mult=1263.39495838

CL (out 0) capacitor c=1p

tran_run1 tran stop=11n step=1p


simulator lang=spice

.MEASURE TRAN trise
+ TRIG V(in0) VAL=0.4 FALL=1
+ TARG V(out) VAL=0.4 FALL=1

.MEASURE TRAN tfall
+ TRIG V(in0) VAL=0.4 RISE=1
+ TARG V(out) VAL=0.4 RISE=1

.MEASURE TRAN tpd param='(trise+tfall)/2'

